[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://tests/demo/room_ui.gd" id="1_room"]
[ext_resource type="Script" path="res://addons/godot_easy_network/network_instance.gd" id="2_network"]

[node name="RoomUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_room")

[node name="Network" type="Node" parent="."]
script = ExtResource("2_network")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
